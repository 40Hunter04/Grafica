    <Target Name="HygViewer">
        <MSBuild Projects="labs\lab2\project\HygViewer.cbproj"/>
    </Target>
    <Target Name="HygViewer:Clean">
        <MSBuild Projects="labs\lab2\project\HygViewer.cbproj" Targets="Clean"/>
    </Target>
    <Target Name="HygViewer:Make">
        <MSBuild Projects="labs\lab2\project\HygViewer.cbproj" Targets="Make"/>
